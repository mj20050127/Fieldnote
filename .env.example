MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=fieldnote
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
SESSION_HOURS=8
# Cloud deployment: set APP_ENV=production, PUBLIC_ORIGIN=https://your-domain
# Compose also requires these values; replace both before public deployment.
MONGO_ROOT_USER=fieldnote_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
DOMAIN=localhost

