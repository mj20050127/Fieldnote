# Copy to the server's project .env. Replace the domain and password before starting.
# A hexadecimal password avoids reserved URI characters in the MongoDB connection string.
MONGO_ROOT_USER=fieldnote_admin
MONGO_ROOT_PASSWORD=replace-with-48-random-hex-characters
COMPOSE_APP_ENV=production
COMPOSE_PUBLIC_ORIGIN=https://survey.example.com
SITE_ADDRESS=survey.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
